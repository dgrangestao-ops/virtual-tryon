{
  "name": "virtual-tryon",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prebuild": "npm run validate:catalog && node scripts/generate-products.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
