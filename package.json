    "test:capture": "node scripts/test-photo-capture.mjs",
    "test:public-mode": "node scripts/test-public-mode.mjs",
    "test:white-label": "node scripts/test-white-label.mjs",
    "test:embed-safety": "node scripts/test-embed-safety.mjs",
    "test:multi-store": "node scripts/test-multi-store.mjs",
    "validate:template": "node scripts/validate-catalog.mjs catalog/store.template.json",
    "onboard:store": "node scripts/onboard-store.mjs",
    "test:onboarding-safety": "node scripts/test-onboarding-safety.mjs",
    "test:asset-isolation": "node scripts/test-asset-isolation.mjs",
    "test:store-registry": "node scripts/test-store-registry.mjs"
